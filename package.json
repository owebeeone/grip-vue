{
  "name": "@owebeeone/grip-vue",
  "version": "0.3.0",
  "description": "Vue 3 integration for GRIP.",
  "author": "Gianni Mariani",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/owebeeone/grip-vue.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@owebeeone/grip-core": "^0.3.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@owebeeone/grip-core": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue": "^3.4.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs,esm",
    "dev": "tsup src/index.ts --dts --format cjs,esm --watch",
    "test": "vitest run",
    "check:source": "node scripts/check-source.mjs",
    "check": "npm run check:source && npm test && npm run build"
  }
}
